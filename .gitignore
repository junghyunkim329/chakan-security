# build outputs (rebuild with CMake)
/build/

# third-party sources and local installs (recreated by scripts/setup/build-vsomeip.sh, versions pinned there)
/third_party/

# Per-run experiment output stays local, including summaries and verdicts.
# Keep curated verification notes and reproduction instructions in docs/evidence.
/docs/results/
/ECU/docs/results/
/IDS/docs/results/

# Completed agent work plans and session artifacts are local working records.
# Durable specifications belong outside these directories.
/docs/superpowers/
/ECU/docs/superpowers/
/IDS/docs/superpowers/
/.superpowers/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# personal
/docs/check/*
*.docx
*.pdf
docs/notion/meeting-*.md
