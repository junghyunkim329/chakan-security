{
	"schema": 1,
	"comment": "Execution Manager manifest (project.md §8.1). ${VAR} values come from --var. BIN_DIR must be a deployed, root-owned, non-writable copy of the build outputs. Project selection, not AUTOSAR Manifest.",
	"policy": {
		"heartbeat_period_ms": 500,
		"missed_heartbeats": 3,
		"restart_delay_ms": 500,
		"max_failures": 3,
		"failure_window_s": 60,
		"startup_timeout_ms": 5000,
		"stop_timeout_ms": 2000
	},
	"processes": [
		{
			"name": "engine",
			"executable": "${BIN_DIR}/ecu_engine",
			"args": ["--iface", "${CAN_VEH_IF}"],
			"netns": "${NS_VEH}",
			"user": "${RUN_AS}",
			"capabilities": [],
			"depends_on": [],
			"limits": {"memory_mb": 64, "cpus": "1", "nice": 0, "open_files": 64}
		},
		{
			"name": "brake",
			"executable": "${BIN_DIR}/ecu_brake",
			"args": ["--iface", "${CAN_VEH_IF}"],
			"netns": "${NS_VEH}",
			"user": "${RUN_AS}",
			"capabilities": [],
			"depends_on": [],
			"limits": {"memory_mb": 64, "cpus": "1", "nice": 0, "open_files": 64}
		},
		{
			"name": "steering",
			"executable": "${BIN_DIR}/ecu_steering",
			"args": ["--iface", "${CAN_VEH_IF}"],
			"netns": "${NS_VEH}",
			"user": "${RUN_AS}",
			"capabilities": [],
			"depends_on": [],
			"limits": {"memory_mb": 64, "cpus": "1", "nice": 0, "open_files": 64}
		},
		{
			"name": "gateway",
			"executable": "${BIN_DIR}/vehicle_gateway",
			"args": ["--iface", "${CAN_GW_IF}"],
			"netns": "${NS_GW}",
			"user": "${RUN_AS}",
			"capabilities": [],
			"depends_on": ["engine", "brake", "steering"],
			"env": {"VSOMEIP_CONFIGURATION": "${ROOT}/config/vsomeip/gateway.json"},
			"limits": {"memory_mb": 1024, "cpus": "2", "nice": 0, "open_files": 256}
		},
		{
			"name": "consumer",
			"executable": "${BIN_DIR}/vehicle_state_consumer",
			"args": ["--duration-s", "0"],
			"netns": "${NS_AP}",
			"user": "${RUN_AS}",
			"capabilities": [],
			"depends_on": ["gateway"],
			"env": {"VSOMEIP_CONFIGURATION": "${ROOT}/config/vsomeip/consumer.json"},
			"limits": {"memory_mb": 1024, "cpus": "3", "nice": 0, "open_files": 256}
		}
	]
}
